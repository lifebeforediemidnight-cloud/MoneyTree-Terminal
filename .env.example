# GEMINI_API_KEY: Required for Gemini AI API calls.


GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.

# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_PATH: SQLite file or local store for broker accounts and paper portfolio data
DATABASE_PATH="trading_terminal.db"

# ENCRYPTION_KEY: 32-byte hex master key for the AES-256-GCM credential vault
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# PYTHON_VENV_PATH: Path to the embedded Python environment with ccxt
PYTHON_VENV_PATH="/opt/venv"

# DHAN_API_BASE: Dhan REST API base endpoint
DHAN_API_BASE="https://api.dhan.co"

# DHAN_WS_FEED: Dhan market data WebSocket url
DHAN_WS_FEED="wss://api-feed.dhan.co"
